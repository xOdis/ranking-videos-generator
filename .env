# Environment variables. Copy from .env.example and edit if needed.
# Pointing at your existing FFmpeg 8.1.2 build so yt-dlp + the renderer both work.
FFMPEG_BIN=C:\Users\WIN 11\Downloads\ffmpeg-8.1.2-essentials_build\ffmpeg-8.1.2-essentials_build\bin\ffmpeg.exe
FFPROBE_BIN=C:\Users\WIN 11\Downloads\ffmpeg-8.1.2-essentials_build\ffmpeg-8.1.2-essentials_build\bin\ffprobe.exe
# Default download directory for source clips
DOWNLOAD_DIR=temp/downloads
# Default output directory
OUTPUT_DIR=output
# Hardware acceleration: auto | none | qsv | nvenc | amf | videotoolbox
HW_ACCEL=none
# Maximum parallel downloads
MAX_WORKERS=3
# Log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
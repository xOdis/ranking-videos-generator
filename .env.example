# Optional environment variables. Copy to .env and edit.
# Path to ffmpeg executable (leave blank to use system PATH)
FFMPEG_BIN=
# Path to ffprobe executable (leave blank to use system PATH)
FFPROBE_BIN=
# Default download directory for source clips
DOWNLOAD_DIR=temp/downloads
# Default output directory
OUTPUT_DIR=output
# Hardware acceleration: auto | none | qsv | nvenc | amf | videotoolbox
HW_ACCEL=none
# Maximum parallel downloads
MAX_WORKERS=3
# Log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO